{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "What the tray panel may ask of the app: its own commands, nothing else.",
  "windows": ["panel"],
  "permissions": [
    "allow-subscribe",
    "allow-open-in-browser",
    "allow-reveal-folder",
    "allow-stop-preview",
    "allow-stop",
    "allow-force-stop",
    "allow-quit-app-preview",
    "allow-quit-app",
    "allow-open-cleaner",
    "allow-resize-panel",
    "allow-hide-panel",
    "allow-quit"
  ]
}
